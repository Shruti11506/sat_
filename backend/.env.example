# Supabase project URL, e.g. https://xxxxx.supabase.co
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL

# Public/anon key -- safe to expose to a browser client, kept here for parity
# with the frontend's config. Not currently used by the backend's own calls.
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-side secret/service-role key. NEVER expose this to the frontend.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

APP_NAME=SatQuery Backend
APP_VERSION=0.1.0
APP_ENV=development

# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
